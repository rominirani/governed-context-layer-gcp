{
  "mcpServers": {
    "chai-cloudsql-toolbox": {
      "command": "./toolbox",
      "args": [
        "--tools-file",
        "/path/to/governed-context-layer-gcp/tools.yaml",
        "--stdio"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "chai-and-co-prod",
        "CLOUD_SQL_REGION": "asia-south1",
        "CLOUD_SQL_INSTANCE": "chai-and-co-pg",
        "DB_NAME": "chai_and_co"
      }
    },
    "chai-local-context-layer": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "/path/to/governed-context-layer-gcp/chai_context_mcp_server.py"
      ]
    }
  }
}
